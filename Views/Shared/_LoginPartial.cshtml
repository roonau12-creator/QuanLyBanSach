@using BookShop.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <a class="text-white-50 text-decoration-none small fw-medium">
        @UserManager.GetUserName(User)
    </a>
    <form method="post" asp-action="Logout" asp-controller="Account" asp-area="Identity">
        <button type="submit" class="btn btn-sm btn-outline-light"
                style="font-size: 0.7rem;letter-spacing:0.05rem;text-transform:uppercase;">
            Logout
        </button>
    </form>
}
else
{



    <a class="text-black-50 text-decoration-none small fw-medium nav-link-hover" asp-action="Register"
       asp-controller="Account" asp-area="Identity">Register</a>
    <a class="text-black-50 text-decoration-none small fw-medium nav-link-hover" asp-action="Login" asp-controller="Account"
       asp-area="Identity">Login</a>
}