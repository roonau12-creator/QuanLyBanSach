<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookShopmvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/BookShopmvc.styles.css" asp-append-version="true" />
    <link href="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.css" rel="stylesheet" asp-append-version="true">
    <style>
        body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #f8f9fa;
        }

        .admin-sidebar {
        width: 240px;
        background: #191414;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .admin-sidebar-nav .nav-link {
        color: #94a3b8;
        font-size: 0.875rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        text-decoration: none;
        }

        .admin-sidebar-nav .nav-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.05);
        }

        .admin-sidebar-nav .nav-link.active {
        color: #fff;
        background: #17A34A;
        }

        .admin-sidebar-nav .nav-section {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        padding: 0.5rem 0.75rem;
        margin-top: 0.75rem;
        }
    </style>

</head>

<body>
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" style="background: #191414;">
        <div class="offcanvas-header border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
            <h6 class="mb-0 fw-semibold text-white">BulkyBook <small class="text-success">Admin</small></h6>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-3">
            <div class="admin-sidebar-nav">
                <partial name="_AdminSideBarNav" />
            </div>
        </div>
    </div>

    <div class="d-flex">
        <aside class="admin-sidebar d-none d-lg-flex flex-column position-sticky top-0" style="height: 100vh;">
            <div class="p-3 border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                <h6 class="mb-0 fw-semibold text-white">BulkyBook <small class="text-success">Admin</small></h6>
            </div>

            <nav class="flex-grow-1 overflow-auto p-3">
                <partial name="_AdminSideBarNav" />
            </nav>

            <div class="border-top p-3" style="border-color: rgba(255,255,255,0.1) !important;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-circle" style="color: #94a3b8;"></i>
                    <!-- TODO: Display username -->
                    <span class="small text-truncate flex-grow-1 text-white">@User.Identity?.Name</span>
                    <button id="themeToggle" class="btn btn-sm btn-link p-0" style="color: #94a3b8;" type="button"
                            title="Toggle theme">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <!-- TODO: Add link to store -->
                    <a asp-area="Customer" asp-action="Index" asp-controller="Home"
                       class="btn btn-sm btn-outline-light flex-grow-1">
                        <i class="bi bi-shop"></i> Store
                    </a>
                    <form method="post" asp-action="Logout" asp-controller="Account" asp-area="Identity">
                        <button type="submit" class="btn btn-sm btn-outline-light"
                                style="font-size: 0.7rem;letter-spacing:0.05rem;text-transform:uppercase;">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                    <!-- TODO: Add logout form -->
                </div>
            </div>
        </aside>

        <main class="flex-grow-1">
            <div class="p-4">
                <partial name="_Notification" />
                @RenderBody()
                <!-- TODO: Render notification partial and page body -->
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
